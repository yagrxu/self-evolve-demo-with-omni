  "stages": {
    "S0": {
      "question": "值得继续吗（control，筛选）",
      "min_scenarios": 20,
      "mean_delta": ">= max(business.min_meaningful_improvement, 0)",
      "ci_lower": ">= -non_inferiority_margin.S0",
      "per_dim_regression": ">= -max(non_inferiority_margin.S0, flip_resolution)",
      "token_pct": "<= business.token_budget_pct",
      "latency_pct": "<= business.latency_budget_pct",
      "safety_new_failures": "== 0"
    },
    "S1": {
      "question": "没见过的题上不更差（confirm 集）",
      "min_scenarios": 40,
      "mean_delta": ">= 0",
      "ci_lower": ">= -non_inferiority_margin.S1",
      "per_dim_regression": ">= -max(non_inferiority_margin.S1, flip_resolution)",
      "token_pct": "<= business.token_budget_pct",
      "latency_pct": "<= business.latency_budget_pct",
      "safety_new_failures": "== 0"
    },
    "S2": {
      "question": "真的更好吗（云上灰度，真实流量）",
      "min_scenarios": 200,
      "mean_delta": ">= max(business.min_meaningful_improvement, 2 * aa_noise)",
      "ci_lower": ">= 0",
      "per_dim_regression": ">= -0.02",
      "token_pct": "<= business.token_budget_pct",
      "latency_pct": "<= business.latency_budget_pct",
      "safety_new_failures": "== 0"
    }
  },
