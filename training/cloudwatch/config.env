# training/cloudwatch —— 全流程唯一的配置入口。所有脚本先 source 它。
# 只改这里，不要在脚本里写死 region / 名称。

# ── 环境 ────────────────────────────────────────────────────────────────
export AWS_REGION="${AWS_REGION:-us-west-2}"
export AWS_DEFAULT_REGION="$AWS_REGION"

# ── 本次 run ────────────────────────────────────────────────────────────
# RUN_ID 决定所有产物目录和 session 前缀。换一轮实验就换一个 RUN_ID。
# 只用 [a-z0-9]（不含连字符 / 下划线）：session id 按连字符切分来还原 scenario。
export RUN_ID="${RUN_ID:-cwt01}"

# ── Agent（CDK 部署，见 01_deploy.sh）──────────────────────────────────
export STACK_PREFIX="selfevolve-demo"
export RUNTIME_BASE="selfevolve_demo_order_support"
export ENDPOINT_NAME="v1"

# 当前线上 baseline 的 prompts.json（候选以它为底稿；必须与已部署的 baseline 一致）
export BASELINE_PROMPTS="${BASELINE_PROMPTS:-training/cloudwatch/baseline/prompts.json}"  # order_support-v1

# ── 数据集 ──────────────────────────────────────────────────────────────
# control：诊断 + 候选挑选；confirm：从未用于挑选的确认集（S1）
export CONTROL_DATASET_FILE="datasets/prod_sim.json"
export CONFIRM_DATASET_FILE="datasets/fresh.json"
# 确认集不够 S1 最少样本时，用第二份未用于挑选的数据集扩充（compare --set confirm,confirm2）
export CONFIRM2_DATASET_FILE="datasets/verify.json"

# ── 评估 ────────────────────────────────────────────────────────────────
export GATES_FILE="training/cloudwatch/gates.json"
# AgentCore 托管的 OTel span 都在这个 log group（Transaction Search 开启后）
export SPANS_LOG_GROUP="aws/spans"
export BATCH_RESULTS_LOG_GROUP="/aws/bedrock-agentcore/evaluations/batch-evaluations/results/default"
